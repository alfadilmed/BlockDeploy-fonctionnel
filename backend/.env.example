# Example .env file - copy to .env and fill in your actual values
# These are loaded by app/core/config.py

# LLM Configuration
LLM_PROVIDER="mock" # or "openai", "gemini"
LLM_API_KEY="your_llm_api_key_if_not_mock" # Required if provider is not mock
LLM_DEFAULT_MODEL="mock-model" # e.g., "gpt-3.5-turbo", "gemini-pro", or "mock-model" if provider is mock

# RAG Configuration
# Paths are relative to backend/app/data/ or can be absolute.
# Defaults are "faiss_index.bin", "doc_metadata.json", "all-MiniLM-L6-v2" if not set.
# FAISS_INDEX_PATH="my_custom_faiss_index.bin"
# DOC_METADATA_PATH="my_custom_metadata.json"
# EMBEDDING_MODEL_NAME="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2" # Example of another model

# Rate Limiting
# DEFAULT_RATE_LIMIT="100/hour" # Example: 100 requests per hour

# Logging (optional, defaults are in config.py)
# LOG_LEVEL="DEBUG"
