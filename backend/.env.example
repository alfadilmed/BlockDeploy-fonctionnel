# Example .env file - copy to .env and fill in your actual values
# These are loaded by app/core/config.py

# LLM Configuration
LLM_PROVIDER="mock" # or "openai", "gemini"
LLM_API_KEY="your_llm_api_key_if_not_mock"
LLM_DEFAULT_MODEL="your_chosen_model_if_not_mock" # e.g., "gpt-3.5-turbo" or "gemini-pro"

# Logging (optional, defaults are in config.py)
# LOG_LEVEL="DEBUG"
